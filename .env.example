# ─────────────────────────────────────────
# PostgreSQL
# ─────────────────────────────────────────
POSTGRES_USER=openbench
POSTGRES_PASSWORD=openbench_secret
POSTGRES_DB=openbench

# Assembled by docker-compose for the app container
DATABASE_URL=postgresql://openbench:openbench_secret@postgres:5432/openbench

# ─────────────────────────────────────────
# Inngest
# ─────────────────────────────────────────
# Use any string locally; replace with real keys in production
INNGEST_EVENT_KEY=local
INNGEST_SIGNING_KEY=local
INNGEST_BASE_URL=http://inngest:8288

# ─────────────────────────────────────────
# Sia Storage (decentralised object store)
# ─────────────────────────────────────────
# SIA_MODE=auto        # "auto" (default) or "demo"
# SIA_INDEXER_URL=https://sia.storage
# Generate with: python -c "import os; print(os.urandom(32).hex())"
# SIA_APP_ID=
# SIA_APP_NAME=OpenBench
# SIA_APP_SERVICE_URL=http://backend:8000
# Where persisted app key & recovery phrase live (Docker data volume)
# SIA_KEY_PATH=/app/data/appkey.hex
# SIA_PHRASE_PATH=/app/data/phrase.enc

# ─────────────────────────────────────────
# OpenRouter (sole LLM provider)
# ─────────────────────────────────────────
# Get your key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# ─────────────────────────────────────────
# Next.js
# ─────────────────────────────────────────
NEXT_TELEMETRY_DISABLED=1
