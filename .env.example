# ─────────────────────────────────────────
# PostgreSQL
# ─────────────────────────────────────────
POSTGRES_USER=openbench
POSTGRES_PASSWORD=openbench_secret
POSTGRES_DB=openbench

# Assembled by docker-compose for the app container
DATABASE_URL=postgresql://openbench:openbench_secret@postgres:5432/openbench

# ─────────────────────────────────────────
# Inngest
# ─────────────────────────────────────────
# Use any string locally; replace with real keys in production
INNGEST_EVENT_KEY=local
INNGEST_SIGNING_KEY=local
INNGEST_BASE_URL=http://inngest:8288

# ─────────────────────────────────────────
# Next.js
# ─────────────────────────────────────────
NEXT_TELEMETRY_DISABLED=1
