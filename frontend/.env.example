# ─────────────────────────────────────────
# PostgreSQL
# ─────────────────────────────────────────
DATABASE_URL=postgresql://<username>:<password>@localhost:5432/<database_name>

# ─────────────────────────────────────────
# Inngest
# ─────────────────────────────────────────
INNGEST_DEV=1
INNGEST_EVENT_KEY=local
INNGEST_SIGNING_KEY=local
INNGEST_BASE_URL=http://localhost:8288

# ─────────────────────────────────────────
# Next.js
# ─────────────────────────────────────────
NEXT_TELEMETRY_DISABLED=1

# ─────────────────────────────────────────
# Backend
# ─────────────────────────────────────────
BACKEND_URL=http://localhost:8000

# ─────────────────────────────────────────
# Auth
# ─────────────────────────────────────────
AUTH_SECRET=lTtDZlfpNjrSIA2EocS7GEAaH3SHLsOr41X4udYY1k4=
AUTH_URL=http://localhost:3000

# ─────────────────────────────────────────
# Uploads directory (optional override)
# ─────────────────────────────────────────
# Where uploaded task ZIP files are stored.
# Default (local): ./uploads  (relative to frontend/ directory, auto-created)
# Docker:          /uploads   (mapped from task_uploads volume, set in docker-compose.yml)
# Uncomment to override:
# UPLOADS_DIR=/path/to/uploads
