# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/openbench

# ── Frontend → Backend routing ────────────────────────────────────────────────
# When running with Docker Compose this stays as-is (resolved via Docker DNS).
# When running locally with `next dev` + `uvicorn` the frontend code automatically
# rewrites "backend" → "localhost", so you do NOT need to change this.
BACKEND_URL=http://localhost:8000

# Set to "1" inside the Docker frontend container (already done in docker-compose.yml).
# Leave unset (or "0") for local `next dev`.
RUNNING_IN_DOCKER=0

# ── Inngest ───────────────────────────────────────────────────────────────────
INNGEST_BASE_URL=http://localhost:8288
# Leave unset for local dev (Inngest CLI listens on localhost:8288 automatically).

# ── LLM providers ─────────────────────────────────────────────────────────────
# Set the key for the provider you want to use.
# Priority: deepseek > openrouter > openai  (first non-empty key wins).

# DeepSeek direct — https://platform.deepseek.com/
DEEPSEEK_API_KEY=

# OpenRouter (access DeepSeek, Llama, Mistral, Gemini, etc.) — https://openrouter.ai/keys
OPENROUTER_API_KEY=

# OpenAI — fallback / legacy
OPENAI_API_KEY=

# ── Default model (used by easiness / difficulty / agent_quality stages) ──────
# deepseek  → deepseek-chat  (DeepSeek-V3) or deepseek-reasoner (R1)
# openrouter → deepseek/deepseek-chat-v3-0324:free  (or any OpenRouter slug)
# openai    → gpt-4o
DEFAULT_PROVIDER=deepseek
DEFAULT_MODEL_ID=deepseek-v4-flash
