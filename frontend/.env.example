# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/openbench

# ── Frontend → Backend routing ────────────────────────────────────────────────
# When running with Docker Compose this stays as-is (resolved via Docker DNS).
# When running locally with `next dev` + `uvicorn` the frontend code automatically
# rewrites "backend" → "localhost", so you do NOT need to change this.
BACKEND_URL=http://localhost:8000

# Set to "1" inside the Docker frontend container (already done in docker-compose.yml).
# Leave unset (or "0") for local `next dev`.
RUNNING_IN_DOCKER=0

# ── Inngest ───────────────────────────────────────────────────────────────────
INNGEST_BASE_URL=http://localhost:8288
# Leave unset for local dev (Inngest CLI listens on localhost:8288 automatically).

# ── LLM provider (OpenRouter only) ────────────────────────────────────────────
# All LLM calls route through OpenRouter — supports DeepSeek, Claude, GPT,
# Gemini, Llama, Mistral, and hundreds more via a single API key.
# Get your key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# ── Model configuration ───────────────────────────────────────────────────────
# Models are configured via the admin UI at /admin/models
# No need to set DEFAULT_PROVIDER or DEFAULT_MODEL_ID here.

# ── OAuth providers ───────────────────────────────────────────────────────────
# GitHub OAuth — get your credentials at https://github.com/settings/developers
# Create an OAuth app with callback URL: http://localhost:3000/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Google OAuth — get your credentials at https://console.cloud.google.com/apis/credentials
# Create an OAuth 2.0 Web Client with redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── WebAuthn / Passkeys ───────────────────────────────────────────────────────
# The RP ID (domain) and origin for WebAuthn passkey authentication.
# In development these typically stay as localhost:3000.
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:3000