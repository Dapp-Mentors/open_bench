// prisma/schema.prisma

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Auth (NextAuth v5 / Auth.js) ─────────────────────────────────────────────

// Role hierarchy:
//   user       → submit tasks to existing projects, view results
//   admin      → everything user can + create projects, approve/reject tasks, run benchmarks
//   super_admin → everything admin can + manage model configuration & system settings

enum Role {
  user
  admin
  super_admin
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  role          Role      @default(user)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  passkeys      Passkey[]
  tasks         Task[]            @relation("TaskSubmitter")
  memberships   ProjectMember[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Passkey / WebAuthn credentials (one user can have multiple devices)
model Passkey {
  id                   String   @id @default(cuid())
  userId               String
  credentialId         String   @unique   // base64url-encoded credential ID
  publicKey            String   @db.Text  // base64url-encoded COSE public key
  counter              BigInt   @default(0)
  deviceType           String   @default("platform")  // platform | cross-platform
  backedUp             Boolean  @default(false)
  transports           String?  // JSON array of transport strings
  name                 String   @default("Passkey")   // user-visible label
  createdAt            DateTime @default(now())
  lastUsedAt           DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─── Project ──────────────────────────────────────────────────────────────────

model Project {
  id          String   @id @default(cuid())
  name        String
  description String   @db.Text
  domain      String
  projectType String   @default("coding_software")
  rules       String   @default("")   @db.Text
  tags        String[] @default([])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tasks       Task[]
  members     ProjectMember[]
}

// ─── ProjectMember ────────────────────────────────────────────────────────────
// Tracks which users are members of which projects (many-to-many).

model ProjectMember {
  id        String   @id @default(cuid())
  userId    String
  projectId String
  role      String   @default("member") // member | manager
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([userId, projectId])
  @@index([userId])
  @@index([projectId])
}

// ─── Task ─────────────────────────────────────────────────────────────────────

model Task {
  id               String         @id @default(cuid())
  projectId        String
  project          Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  submittedById    String?                          // who submitted this task

  title            String
  description      String         @default("")
  domain           String
  language         String
  storagePath      String

  dockerImage      String         @default("")
  timeoutMs        Int            @default(120000)
  scoringType      String         @default("passfail")
  expectedOutput   String?
  expectedPattern  String?

  status           String         @default("pending")
  similarityScore  Float?
  isDuplicate      Boolean?
  ciPassed         Boolean?
  qualityScore     Float?
  qualityDetails   String?
  easinessResult   String?
  agentQualityNote String?

  siaHash          String?
  indexdKey        String?
  embeddingJson    String?

  siaStatus        String         @default("pending")

  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  approvedAt       DateTime?

  pipelineLogs     PipelineLog[]
  siaLogs          SiaLog[]
  runs             BenchmarkRun[]
  submitter        User?          @relation("TaskSubmitter", fields: [submittedById], references: [id], onDelete: SetNull)

  @@index([submittedById])
}

// ─── PipelineLog ──────────────────────────────────────────────────────────────

model PipelineLog {
  id      String   @id @default(cuid())
  taskId  String
  task    Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  stage   String
  passed  Boolean?
  message String   @default("")
  ts      DateTime @default(now())

  @@index([taskId])
}

// ─── SiaLog ───────────────────────────────────────────────────────────────────

model SiaLog {
  id      String   @id @default(cuid())
  taskId  String
  task    Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  step    String
  passed  Boolean?
  message String   @default("")
  ts      DateTime @default(now())

  @@index([taskId])
}

// ─── BenchmarkRun ─────────────────────────────────────────────────────────────

model BenchmarkRun {
  id         String   @id @default(cuid())
  taskId     String
  task       Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  projectId  String

  provider   String
  modelId    String

  status     String   @default("running")
  score      Float?
  runtimeMs  Int?
  tokenUsage Int?

  siaHash    String?
  indexdKey  String?

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  logs       RunLog[]

  @@index([taskId])
  @@index([projectId])
}

// ─── RunLog ───────────────────────────────────────────────────────────────────

model RunLog {
  id     String       @id @default(cuid())
  runId  String
  run    BenchmarkRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  stream String
  line   String
  ts     DateTime     @default(now())

  @@index([runId])
}

// ─── BenchmarkType ────────────────────────────────────────────────────────────
// Admin-managed list of active benchmark categories. Controls which types
// appear in the ProjectTypeSelector on project creation.

model BenchmarkType {
  id        String   @id
  label     String
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── ModelConfig ──────────────────────────────────────────────────────────────

model ModelConfig {
  id        String   @id @default(cuid())
  key       String   @unique
  modelId   String
  modelName String   @default("")
  updatedAt DateTime @updatedAt
}
