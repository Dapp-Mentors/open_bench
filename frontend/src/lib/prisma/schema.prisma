generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum JobStatus {
  uploading
  transcribing
  detecting
  extracting
  rendering
  storing
  complete
  failed
}

enum StageStatus {
  pending
  running
  complete
  failed
}

enum SegmentStatus {
  pending
  approved
  rejected
}

enum SiaStatus {
  pending
  queued
  uploading
  pinning
  ready
  failed
}

model AppSettings {
  id                 String   @id @default("default")
  setupComplete      Boolean  @default(false)

  // Sia configuration (set via setup wizard)
  siaConnected       Boolean  @default(false)
  siaIndexerUrl      String?
  siaAppId           String?
  siaAppName         String?
  siaAppDescription  String?

  // OpenRouter API key
  openrouterKey      String?

  // Social login provider keys
  googleClientId     String?
  googleClientSecret String?
  githubClientId     String?
  githubClientSecret String?

  // WebAuthn / Passkey config
  webauthnRpId       String?
  webauthnOrigin     String?

  // Auth secret (generated during setup, stored in DB instead of env)
  authSecret         String?

  // Backend URL (FastAPI service URL, stored in DB instead of env)
  backendUrl         String?

  // YouTube cookies metadata for yt-dlp (the file itself lives on disk;
  // no YT_DLP_COOKIES env var required — path defaults automatically)
  youtubeCookiesSize      Int?
  youtubeCookiesUpdatedAt DateTime?

  // Pipeline retry config
  difficultyMaxRetries Int    @default(3)
  updatedAt          DateTime @updatedAt

  @@map("app_settings")
}

model Job {
  id                String        @id @default(cuid())
  status            JobStatus     @default(uploading)
  sourceFilename    String        @map("source_filename")
  sourceUrl         String?       @map("source_url")
  sourceSiaObjectId String?       @map("source_sia_object_id")
  durationSeconds   Int?          @map("duration_seconds")
  siaHash           String?       @map("sia_hash")
  indexdKey         String?       @map("indexd_key")
  siaStatus         SiaStatus     @default(pending) @map("sia_status")
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  transcript        Transcript?
  segments          Segment[]
  pipelineSteps     PipelineStep[]
  siaLogs           SiaLog[]

  @@map("jobs")
}

model Transcript {
  id          String   @id @default(cuid())
  jobId       String   @unique @map("job_id")
  job         Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  vttContent  String   @map("vtt_content")
  jsonContent Json     @map("json_content")
  siaObjectId String?  @map("sia_object_id")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("transcripts")
}

model Segment {
  id                String        @id @default(cuid())
  jobId             String        @map("job_id")
  job               Job           @relation(fields: [jobId], references: [id], onDelete: Cascade)
  startSeconds      Float         @map("start_seconds")
  endSeconds        Float         @map("end_seconds")
  hookStrength      String        @map("hook_strength")
  viralityScore     Int           @map("virality_score")
  emotionalSignal   String        @map("emotional_signal")
  transcriptExcerpt String        @map("transcript_excerpt")
  status            SegmentStatus @default(pending)
  clipPath          String?       @map("clip_path")
  siaObjectId       String?       @map("sia_object_id")
  createdAt         DateTime      @default(now()) @map("created_at")

  @@map("segments")
}

model PipelineStep {
  id          String      @id @default(cuid())
  jobId       String      @map("job_id")
  job         Job         @relation(fields: [jobId], references: [id], onDelete: Cascade)
  stage       String
  status      StageStatus @default(pending)
  progressPct Int         @default(0) @map("progress_pct")
  message     String      @default("")
  startedAt   DateTime?   @map("started_at")
  completedAt DateTime?   @map("completed_at")

  @@map("pipeline_steps")
}

model SiaLog {
  id      String   @id @default(cuid())
  jobId   String   @map("job_id")
  job     Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  step    String
  passed  Boolean?
  message String   @default("")
  ts      DateTime @default(now())

  @@map("sia_logs")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime? @map("email_verified")
  image         String?
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  accounts  Account[]
  sessions  Session[]
  passkeys  Passkey[]

  @@map("users")
}

model Passkey {
  id            String   @id
  userId        String   @map("user_id")
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  credentialId  String   @unique @map("credential_id")
  publicKey     Bytes    @map("public_key")
  counter       BigInt   @default(0)
  deviceType    String   @map("device_type")
  backedUp      Boolean  @default(false)
  transports    String   @default("[]")
  name          String   @default("Passkey")
  createdAt     DateTime @default(now()) @map("created_at")
  lastUsedAt    DateTime? @map("last_used_at")

  @@map("passkeys")
}

model PasskeyChallenge {
  id        String   @id @default(cuid())
  key       String   @unique
  challenge String
  expiresAt DateTime @map("expires_at")

  @@map("passkey_challenges")
}

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  session_token String  @unique
  userId       String   @map("user_id")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expires      DateTime
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}